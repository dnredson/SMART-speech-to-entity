# Nunca coloque chaves reais no Git.
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_AQUI

# Modelos usados na V0.5. Podem ser trocados sem alterar o código.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# openai = extração semântica por Structured Outputs
# rules = parser determinístico legado, útil apenas para comparação/debug
ENTITY_EXTRACTOR=openai

# openai = API de transcrição
# local = faster-whisper (requer pip install -e ".[local-stt]")
STT_PROVIDER=openai

# Persistência oficial do piloto
PERSISTENCE_PROVIDER=firebase
FIREBASE_PROJECT_ID=smart-app-b807a
FIREBASE_STORAGE_BUCKET=smart-app-b807a.firebasestorage.app
FIRESTORE_EVENTS_COLLECTION=irrigation_events
FIRESTORE_USAGE_COLLECTION=openai_usage
FIREBASE_AUDIO_PREFIX=irrigation-audio

# Fora do Google Cloud, aponte para o JSON completo da service account.
# O arquivo deve ficar fora do Git; por exemplo em ../../secrets/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=../../secrets/firebase-service-account.json

# Para desenvolvimento estritamente local ainda é possível usar:
# PERSISTENCE_PROVIDER=sqlite
# SMART_IRRIGATION_DATA_DIR=./data

# Guarda-costas adicional ao hard spend limit configurado na OpenAI.
# Uma gravação por voz normalmente consome 2 chamadas: transcrição + extração.
OPENAI_MAX_CALLS_PER_MONTH=100

# Limites locais
MAX_AUDIO_BYTES=20971520
MAX_TRANSCRIPT_CHARS=5000

# Desenvolvimento
CORS_ORIGINS=http://localhost:8503,http://127.0.0.1:8503
